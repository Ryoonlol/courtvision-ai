# ---- Google Gemini
# The backend reaches Gemini one of two ways (it falls back to rule-based text if neither works):
#   agy  - the local Antigravity CLI (`agy`), using whatever account it is signed in with. No API key needed.
#   sdk  - the official google-genai SDK with GEMINI_API_KEY.
# auto = use the SDK when GEMINI_API_KEY is set, otherwise agy if it is installed.
GEMINI_PROVIDER=auto
AGY_BIN=agy
AGY_MODEL=gemini-3.8-flash-low
AGY_TIMEOUT_S=120
# Gemini forecast model (second projection model): model and players per agy call
FORECAST_MODEL=gemini-3.8-flash-low
FORECAST_BATCH=20

# Get a key at https://aistudio.google.com/apikey . It is only read by the backend, never sent to the browser.
GEMINI_API_KEY=
# Any currently supported Gemini model id. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Seconds before a Gemini request times out (retries with backoff on 429/5xx)
GEMINI_TIMEOUT_S=45

# ---- Data
# auto  = real NBA data from ESPN's public API; offline demo data only if that fails on first run
# live  = real data only (error if unavailable)
# demo  = fictional offline demo league (stored in separate *_demo files)
DATA_MODE=auto
# Refresh recent results / schedule / injuries on startup when older than 3 hours
REFRESH_ON_STARTUP=1

# ---- Optional overrides
# COURTVISION_DB=backend/storage/courtvision.db
# COURTVISION_MODEL=backend/storage/projection_model.joblib
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
